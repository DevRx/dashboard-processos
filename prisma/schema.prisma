generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  ADVOGADO
  ASSISTENTE
  USER
}

enum ProcessoStatus {
  EM_ANALISE
  AGUARDANDO_INSS
  PERICIA_MARCADA
  PERICIA_CONCLUIDA
  BENEFICIO_CONCEDIDO
  RECUSADO
  CONCLUIDO
  ARQUIVADO
}

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TarefaPrioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum LancamentoTipo {
  ENTRADA
  SAIDA
}

// ─────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  telefone  String?
  matricula String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  clientes    Cliente[]
  processos   Processo[]             @relation("UserProcessos")
  andamentos  Andamento[]
  tarefas     Tarefa[]
  documentos  Documento[]
  auditorias  Auditoria[]
  lancamentos LancamentoFinanceiro[]
  // Processos onde este usuário é o responsável
  processosResponsavel Processo[] @relation("ResponsavelProcesso")

  @@map("users")
}

model Cliente {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  nome           String
  cpf            String?   @unique
  email          String?
  telefone       String?
  endereco       String?
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  beneficio      String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relações
  user      User       @relation(fields: [userId], references: [id])
  processos Processo[]

  @@map("clientes")
}

model Processo {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  clienteId     String         @map("cliente_id")
  beneficio     String
  numero        String?
  status        ProcessoStatus @default(EM_ANALISE)
  responsavelId String?        @map("responsavel_id")
  dataEntrada   DateTime?      @map("data_entrada") @db.Date
  dataConclusao DateTime?      @map("data_conclusao") @db.Date
  valorCausa    Float?         @map("valor_causa")
  tribunal      String?
  vara          String?
  comarca       String?
  observacoes   String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relações
  user        User        @relation("UserProcessos", fields: [userId], references: [id])
  cliente     Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel User?       @relation("ResponsavelProcesso", fields: [responsavelId], references: [id])
  andamentos  Andamento[]
  tarefas     Tarefa[]
  documentos  Documento[]

  @@map("processos")
}

model Andamento {
  id         String         @id @default(uuid())
  processoId String         @map("processo_id")
  userId     String         @map("user_id")
  data       DateTime       @db.Date
  descricao  String
  status     ProcessoStatus
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relações
  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("andamentos")
}

model Tarefa {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  processoId String?          @map("processo_id")
  titulo     String
  descricao  String?
  data       DateTime         @db.Date
  hora       String?
  status     TarefaStatus     @default(PENDENTE)
  prioridade TarefaPrioridade @default(MEDIA)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  // Relações
  user     User      @relation(fields: [userId], references: [id])
  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)

  @@map("tarefas")
}

model Documento {
  id         String   @id @default(uuid())
  processoId String   @map("processo_id")
  userId     String   @map("user_id")
  nome       String
  url        String
  tipo       String?
  tamanho    Int?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relações
  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("documentos")
}

model LancamentoFinanceiro {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  descricao String
  valor     Float
  tipo      LancamentoTipo
  data      DateTime       @db.Date
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relações
  user User @relation(fields: [userId], references: [id])

  @@map("lancamentos_financeiros")
}

model Auditoria {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id])

  @@map("auditorias")
}
