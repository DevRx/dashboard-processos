generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  ADVOGADO
  ASSISTENTE
  USER
}

enum ProcessoStatus {
  EM_ANALISE
  AGUARDANDO_INSS
  PERICIA_MARCADA
  PERICIA_CONCLUIDA
  BENEFICIO_CONCEDIDO
  RECUSADO
  CONCLUIDO
  ARQUIVADO
}

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TarefaPrioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// Uma dúvida é uma tarefa como as outras — entra no quadro, tem
/// responsável e prazo. O que a distingue é ter uma mãe: ela nasceu de
/// outra tarefa que parou à espera da resposta.
enum TarefaTipo {
  NORMAL
  DUVIDA
}

/// O que o histórico de uma tarefa registra. Append-only: ver
/// supabase/migrations/20260830180000_duvidas_e_historico.sql.
enum EventoTarefaTipo {
  DUVIDA_ABERTA
  DUVIDA_RESPONDIDA
  STATUS_ALTERADO
}

/// Setores do escritório. A identidade de cada um é a cor: no quadro
/// de tarefas ela é lida antes de qualquer texto, que é o ponto —
/// saber de quem é a tarefa sem parar para ler.
/// Os times atuais são vermelho, azul, amarelo e rosa; preto e verde
/// ficaram em tarefas antigas — ver lib/domain/tarefa/time.ts.
enum SetorTarefa {
  VERMELHO
  PRETO
  AZUL
  AMARELO
  VERDE
  ROSA
}

enum LancamentoTipo {
  ENTRADA
  SAIDA
}

/// O trabalho previdenciário começa no administrativo (requerimento no
/// INSS, identificado por protocolo) e só vira judicial — com número
/// CNJ — depois do indeferimento.
enum EsferaProcesso {
  ADMINISTRATIVO
  JUDICIAL
}

/// Acompanhamento da perícia no auxílio por incapacidade. O
/// `ProcessoStatus` descreve o processo inteiro; esta etiqueta
/// descreve só a próxima ação da perícia, que é o que a equipe
/// administrativa precisa ver de relance na fila.
enum SituacaoPericia {
  MARCAR_PERICIA
  PERICIA_MARCADA
  PRORROGACAO
}

enum FonteIntegracao {
  DATAJUD
  MEU_INSS
  GERID
}

/// Base legal para tratar dado sensível previdenciário (art. 11 da LGPD).
enum BaseLegalLGPD {
  /// art. 11, I — consentimento específico e destacado
  CONSENTIMENTO
  /// art. 11, II, "a" — cumprimento de obrigação legal
  OBRIGACAO_LEGAL
  /// art. 11, II, "d" — exercício regular de direitos. Base típica
  /// da procuração previdenciária cadastrada no Meu INSS.
  EXERCICIO_DIREITOS
}

/// Organização da pasta do cliente, no espírito de um cofre de
/// documentos: o operador acha pelo tipo, não pelo nome do arquivo.
enum CategoriaDocumento {
  PROCURACAO
  IDENTIFICACAO
  CPF
  COMPROVANTE_RESIDENCIA
  CNIS
  CARTEIRA_TRABALHO
  LAUDO_MEDICO
  EXAME
  CERTIDAO
  CARTA_BENEFICIO
  OUTRO
}

enum DocumentoINSS {
  CNIS
  CARTA_CONCESSAO
  CARTA_INDEFERIMENTO
  EXTRATO_PAGAMENTO
  REQUERIMENTO_GERID
}

// ─────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  telefone  String?
  matricula String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relações
  clientes             Cliente[]
  processos            Processo[]             @relation("UserProcessos")
  andamentos           Andamento[]
  tarefas              Tarefa[]
  documentos           Documento[]
  auditorias           Auditoria[]
  lancamentos          LancamentoFinanceiro[]
  consentimentos       ConsentimentoLGPD[]
  importacoes          ImportacaoIntegracao[]
  // Processos onde este usuário é o responsável
  processosResponsavel Processo[]             @relation("ResponsavelProcesso")
  // Tarefas atribuídas a este usuário
  tarefasResponsavel   Tarefa[]               @relation("ResponsavelTarefa")
  // Dúvidas que este usuário respondeu
  duvidasRespondidas   Tarefa[]               @relation("QuemRespondeuDuvida")
  eventosTarefa        EventoTarefa[]
  comunicacoesDjen     ComunicacaoDjen[]

  @@map("users")
}

model Cliente {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  nome           String
  cpf            String?   @unique
  email          String?
  telefone       String?
  endereco       String?
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  beneficio      String?
  /// Senha do Meu INSS do titular, guardada cifrada (AES-256-GCM) —
  /// ver lib/seguranca/cofre.ts. A cifra protege dump e backup; a tela
  /// interna mostra o valor em claro para quem opera o escritório.
  senhaMeuInss   String?   @map("senha_meu_inss")
  /// Comentários da equipe na ficha administrativa.
  observacoes    String?
  /// Ponto no mapa de atendimento. Preenchido a partir do município
  /// reconhecido no endereço, ou escolhido à mão na tela do Mapa —
  /// ver lib/domain/localizacao.
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relações
  user           User                   @relation(fields: [userId], references: [id])
  processos      Processo[]
  documentos     Documento[]
  consentimentos ConsentimentoLGPD[]
  importacoes    ImportacaoIntegracao[]

  @@map("clientes")
}

model Processo {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  clienteId       String           @map("cliente_id")
  beneficio       String
  esfera          EsferaProcesso   @default(ADMINISTRATIVO)
  /// Número único CNJ. Só existe na esfera judicial.
  numero          String?
  /// Protocolo do requerimento no INSS, mostrado pelo GERID.
  protocoloInss   String?          @map("protocolo_inss")
  /// NB, presente na carta de concessão e no extrato de pagamento.
  numeroBeneficio String?          @map("numero_beneficio")
  status          ProcessoStatus   @default(EM_ANALISE)
  /// Só faz sentido em auxílio por incapacidade. Nulo = sem etiqueta.
  situacaoPericia SituacaoPericia? @map("situacao_pericia")
  responsavelId   String?          @map("responsavel_id")
  dataEntrada     DateTime?        @map("data_entrada") @db.Date
  dataConclusao   DateTime?        @map("data_conclusao") @db.Date
  prazo           DateTime?        @db.Date
  valorCausa      Float?           @map("valor_causa")
  tribunal        String?
  vara            String?
  comarca         String?
  observacoes     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relações
  user         User                   @relation("UserProcessos", fields: [userId], references: [id])
  cliente      Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  responsavel  User?                  @relation("ResponsavelProcesso", fields: [responsavelId], references: [id])
  andamentos   Andamento[]
  tarefas      Tarefa[]
  documentos   Documento[]
  importacoes  ImportacaoIntegracao[]
  comunicacoes ComunicacaoDjen[]

  @@map("processos")
}

model Andamento {
  id         String         @id @default(uuid())
  processoId String         @map("processo_id")
  userId     String         @map("user_id")
  data       DateTime       @db.Date
  descricao  String
  status     ProcessoStatus
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relações
  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@map("andamentos")
}

model Tarefa {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  processoId    String?          @map("processo_id")
  titulo        String
  descricao     String?
  data          DateTime         @db.Date
  hora          String?
  status        TarefaStatus     @default(PENDENTE)
  prioridade    TarefaPrioridade @default(MEDIA)
  /// Setor do escritório dono da tarefa, identificado por cor no quadro.
  setor         SetorTarefa?
  /// Quem executa. `userId` é quem cadastrou — os dois raramente são a
  /// mesma pessoa num escritório com equipe.
  responsavelId String?          @map("responsavel_id")
  /// Agrupa as tarefas dentro do time — as listas que vieram do
  /// TickTick ("JUDICIAL › ANDAMENTO"). Livre, sem tabela própria.
  pasta         String?
  /// Id da tarefa no sistema de onde ela foi importada. Único: é o que
  /// deixa reimportar a mesma planilha sem duplicar.
  origemId      String?          @unique @map("origem_id")
  tipo          TarefaTipo       @default(NORMAL)
  /// A tarefa que parou à espera desta pergunta. Só dúvida tem mãe —
  /// há um CHECK no banco garantindo isso.
  tarefaPaiId   String?          @map("tarefa_pai_id")
  /// A resposta mora na dúvida, junto da pergunta: é ela que fecha a
  /// dúvida, e quem reabre o caso meses depois procura as duas juntas.
  resposta      String?
  respondidaEm  DateTime?        @map("respondida_em")
  respondidaPor String?          @map("respondida_por")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relações
  user         User              @relation(fields: [userId], references: [id])
  responsavel  User?             @relation("ResponsavelTarefa", fields: [responsavelId], references: [id])
  quemRespondeu User?            @relation("QuemRespondeuDuvida", fields: [respondidaPor], references: [id])
  processo     Processo?         @relation(fields: [processoId], references: [id], onDelete: SetNull)
  tarefaPai    Tarefa?           @relation("DuvidaDaTarefa", fields: [tarefaPaiId], references: [id], onDelete: Cascade)
  duvidas      Tarefa[]          @relation("DuvidaDaTarefa")
  eventos      EventoTarefa[]
  atribuicoes  TarefaAtribuicao[]
  comunicacoes ComunicacaoDjen[]
  avisos       ComunicacaoDjen[] @relation("AvisoDaIntimacao")

  @@index([tarefaPaiId])
  @@index([tipo])
  @@index([status])
  @@map("tarefas")
}

/// Histórico da tarefa. Append-only: um histórico que se edita não é
/// histórico — quem errou o registro corrige acrescentando.
///
/// O evento da dúvida é gravado no clone, não na mãe. A tela da tarefa
/// principal alcança as perguntas pelo laço `tarefaPaiId`, em vez de
/// manter uma segunda cópia que um dia discorda da primeira.
model EventoTarefa {
  id         String           @id @default(uuid())
  tarefaId   String           @map("tarefa_id")
  tipo       EventoTarefaTipo
  /// `SetNull`: a saída de alguém do escritório não apaga o que
  /// aconteceu. O evento continua, sem o nome.
  autorId    String?          @map("autor_id")
  /// A pergunta, em DUVIDA_ABERTA; a resposta, em DUVIDA_RESPONDIDA.
  texto      String?
  statusDe   TarefaStatus?    @map("status_de")
  statusPara TarefaStatus?    @map("status_para")
  createdAt  DateTime         @default(now()) @map("created_at")

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  autor  User?  @relation(fields: [autorId], references: [id])

  @@index([tarefaId, createdAt])
  @@map("eventos_tarefa")
}

/// Documentos do titular. RG, CPF e comprovante de residência valem
/// para todos os casos e existem antes de qualquer requerimento, então
/// pertencem ao cliente; o vínculo com um processo é opcional, para o
/// que é específico de um pedido (laudo, carta de decisão).
model Documento {
  id         String             @id @default(uuid())
  clienteId  String?            @map("cliente_id")
  processoId String?            @map("processo_id")
  categoria  CategoriaDocumento @default(OUTRO)
  userId     String             @map("user_id")
  nome       String
  /// Endereço externo, quando o documento mora fora (sistema de
  /// tribunal, por exemplo). Arquivo enviado pelo CRM usa `caminho`.
  url        String?
  /// Caminho no bucket privado `documentos`. Não é URL: bucket privado
  /// só entrega por URL assinada, que expira.
  caminho    String?
  tipo       String?
  tamanho    Int?
  /// Leitura por IA, guardada para não reenviar o documento a cada
  /// abertura da tela. `iaModelo` registra quem leu: a extração muda
  /// entre versões de modelo.
  iaResumo   String?            @map("ia_resumo")
  iaCampos   Json?              @map("ia_campos")
  iaLidoEm   DateTime?          @map("ia_lido_em")
  iaModelo   String?            @map("ia_modelo")
  createdAt  DateTime           @default(now()) @map("created_at")

  // Relações
  cliente  Cliente?  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// SetNull: excluir o caso não pode levar embora um documento que
  /// vale para todos os casos do titular.
  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])

  @@map("documentos")
}

model LancamentoFinanceiro {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  descricao String
  valor     Float
  tipo      LancamentoTipo
  data      DateTime       @db.Date
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relações
  user User @relation(fields: [userId], references: [id])

  @@map("lancamentos_financeiros")
}

/// Base legal registrada por titular. Sem uma linha vigente aqui,
/// a API de importação recusa o tratamento.
model ConsentimentoLGPD {
  id                String            @id @default(uuid())
  userId            String            @map("user_id")
  clienteId         String            @map("cliente_id")
  baseLegal         BaseLegalLGPD     @map("base_legal")
  /// Finalidade específica do tratamento (art. 6º, I).
  finalidade        String
  /// Identificação da procuração/termo que sustenta a base legal.
  procuracaoRef     String?           @map("procuracao_ref")
  /// Caminho do PDF no bucket privado `procuracoes`. Não é URL: URL de
  /// bucket privado expira, e guardá-la aqui a deixaria vencida.
  procuracaoArquivo String?           @map("procuracao_arquivo")
  procuracaoNome    String?           @map("procuracao_nome")
  /// Fontes que esta base legal autoriza — limita o escopo da importação.
  fontes            FonteIntegracao[]
  /// Autoriza mandar documentos do titular para leitura por IA —
  /// operador novo e transferência internacional (art. 33), que o
  /// consentimento de consultar o INSS não cobre. Desligada por padrão.
  iaAutorizada      Boolean           @default(false) @map("ia_autorizada")
  vigenteDesde      DateTime          @default(now()) @map("vigente_desde")
  retencaoAte       DateTime?         @map("retencao_ate") @db.Date
  /// Revogação (art. 8º, §5º). A linha nunca é deletada: o histórico
  /// é a prova de que houve base legal no período.
  revogadoEm        DateTime?         @map("revogado_em")
  revogadoMotivo    String?           @map("revogado_motivo")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relações
  user        User                   @relation(fields: [userId], references: [id])
  cliente     Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  importacoes ImportacaoIntegracao[]

  @@map("consentimentos_lgpd")
}

/// Registro de tratamento (art. 37) de cada importação. Guarda o
/// resultado estruturado, nunca o documento bruto — o original
/// permanece no GERID/Meu INSS, que é a fonte autoritativa.
model ImportacaoIntegracao {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  clienteId       String?         @map("cliente_id")
  processoId      String?         @map("processo_id")
  consentimentoId String?         @map("consentimento_id")
  fonte           FonteIntegracao
  documento       DocumentoINSS?
  /// Campos extraídos, já minimizados pelo parser.
  dados           Json
  /// SHA-256 do texto de origem: prova de correspondência com o
  /// documento oficial e detecção de reimportação, sem guardar o bruto.
  hashOrigem      String          @map("hash_origem")
  expurgarEm      DateTime?       @map("expurgar_em") @db.Date
  expurgadoEm     DateTime?       @map("expurgado_em")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relações
  user          User               @relation(fields: [userId], references: [id])
  cliente       Cliente?           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  processo      Processo?          @relation(fields: [processoId], references: [id], onDelete: SetNull)
  consentimento ConsentimentoLGPD? @relation(fields: [consentimentoId], references: [id])

  @@map("importacoes_integracao")
}

/// Comunicação publicada no DJEN em nome da OAB do escritório.
///
/// Guardada localmente por dois motivos: a consulta é por intervalo de
/// datas e relê tudo a cada busca, e "já tratei isso" é estado do
/// escritório, que não existe no diário.
model ComunicacaoDjen {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  /// Id da comunicação no DJEN. Único por usuário: é a chave que
  /// impede a mesma intimação de entrar duas vezes.
  djenId                BigInt    @map("djen_id")
  numeroProcesso        String?   @map("numero_processo")
  numeroProcessoMascara String?   @map("numero_processo_mascara")
  siglaTribunal         String?   @map("sigla_tribunal")
  nomeOrgao             String?   @map("nome_orgao")
  tipoComunicacao       String?   @map("tipo_comunicacao")
  tipoDocumento         String?   @map("tipo_documento")
  nomeClasse            String?   @map("nome_classe")
  /// Parte representada, como o diário a nomeia.
  destinatario          String?
  dataDisponibilizacao  DateTime  @map("data_disponibilizacao") @db.Date
  texto                 String
  link                  String?
  /// Prazo lido do texto e a data-limite estimada em dias úteis —
  /// ver lib/integracoes/djen.ts. Estimativa, não cálculo oficial.
  prazoDias             Int?      @map("prazo_dias")
  prazoTrecho           String?   @map("prazo_trecho")
  prazoEstimado         DateTime? @map("prazo_estimado") @db.Date
  /// Casado pelo número do processo, quando ele já existe na base.
  processoId            String?   @map("processo_id")
  /// Tarefa criada a partir do prazo desta intimação.
  tarefaId              String?   @map("tarefa_id")
  /// Leitura da intimação por IA — ver lib/ia/analista-intimacao.ts.
  /// Rascunho de triagem: diz do que se trata e o que fazer, para a
  /// fila ser priorizada sem abrir o texto inteiro.
  iaTipoAto             String?   @map("ia_tipo_ato")
  iaResumo              String?   @map("ia_resumo")
  iaProvidencia         String?   @map("ia_providencia")
  iaUrgencia            String?   @map("ia_urgencia")
  /// De quem é o prazo do texto: ESCRITORIO, OUTRA_PARTE ou NENHUM.
  iaPrazoDeQuem         String?   @map("ia_prazo_de_quem")
  iaAlertas             Json?     @map("ia_alertas")
  iaModelo              String?   @map("ia_modelo")
  iaAnalisadaEm         DateTime? @map("ia_analisada_em")
  /// Compromisso marcado no texto (perícia, audiência): dia, hora e
  /// lugar, lidos pela regra e pela IA — ver lib/domain/intimacao/evento.ts.
  iaEventoTipo          String?   @map("ia_evento_tipo")
  iaEventoData          DateTime? @map("ia_evento_data") @db.Date
  iaEventoHora          String?   @map("ia_evento_hora")
  iaEventoLocal         String?   @map("ia_evento_local")
  /// Mensagem pronta para o cliente. Guardada, não enviada: o envio
  /// depende da configuração `aviso_cliente_whatsapp`.
  iaMensagemCliente     String?   @map("ia_mensagem_cliente")
  /// Tarefa "avisar o cliente" aberta na véspera do evento.
  avisoTarefaId         String?   @map("aviso_tarefa_id")
  tratadaEm             DateTime? @map("tratada_em")
  createdAt             DateTime  @default(now()) @map("created_at")

  // Relações
  user     User      @relation(fields: [userId], references: [id])
  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  tarefa   Tarefa?   @relation(fields: [tarefaId], references: [id], onDelete: SetNull)
  aviso    Tarefa?   @relation("AvisoDaIntimacao", fields: [avisoTarefaId], references: [id], onDelete: SetNull)

  @@unique([userId, djenId])
  @@index([dataDisponibilizacao])
  @@map("comunicacoes_djen")
}

model Auditoria {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relações
  user User @relation(fields: [userId], references: [id])

  @@map("auditorias")
}

/// Onde a tarefa está no fluxo e com quem: uma linha por pessoa, por
/// etapa, por tarefa. Linha aberta (`fimEm` nulo) é trabalho pendente;
/// concluir, mudar de etapa ou tirar alguém encerra a linha com o
/// motivo. Os gatilhos e as funções que mantêm `tarefas.setor`,
/// `responsavel_id` e `status` em dia moram na migration
/// supabase/migrations/20261013200000_fluxo_atribuicoes.sql — o Prisma
/// não os conhece.
model TarefaAtribuicao {
  id            String      @id @default(uuid())
  tarefaId      String      @map("tarefa_id")
  setor         SetorTarefa
  /// Etapa do fluxo (lib/domain/tarefa/fluxo.ts); nula = no time, sem etapa.
  etapa         String?
  responsavelId String?     @map("responsavel_id")
  criadaEm      DateTime    @default(now()) @map("criada_em")
  criadaPor     String?     @map("criada_por")
  fimEm         DateTime?   @map("fim_em")
  fimPor        String?     @map("fim_por")
  /// CONCLUIDA, MOVIDA, REMOVIDA ou TAREFA_FECHADA.
  fimMotivo     String?     @map("fim_motivo")

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@index([tarefaId])
  @@map("tarefa_atribuicoes")
}

/// Configurações do escritório, chave → valor. Nasce com a trava do
/// aviso automático ao cliente (`aviso_cliente_whatsapp`, false).
model Configuracao {
  chave         String   @id
  valor         Json
  descricao     String?
  atualizadaEm  DateTime @default(now()) @map("atualizada_em")
  atualizadaPor String?  @map("atualizada_por")

  @@map("configuracoes")
}

/// Senhas erradas no login (migration 20261015030000): a partir da 5ª em
/// 15 minutos, por e-mail ou por endereço, o login responde 429.
model TentativaLogin {
  id     BigInt   @id @default(autoincrement())
  email  String
  ip     String?
  quando DateTime @default(now())

  @@index([email, quando])
  @@index([ip, quando])
  @@map("tentativas_login")
}
